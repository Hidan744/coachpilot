# Домен API (A-запись должна указывать на сервер), например api.coachpilot.ru
DOMAIN=api.example.ru
# Пароль БД: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=
# Секрет JWT (не меньше 32 символов): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CP_JWT_SECRET=
CP_CORS_ORIGINS=["https://app.example.ru"]

# AI: yandexgpt | gigachat | openai_compat | mock
CP_AI_PROVIDER=yandexgpt
CP_AI_API_KEY=
CP_AI_FOLDER_ID=
CP_AI_FREE_QUOTA_MONTH=30
