CP_ENV=dev
CP_DATABASE_URL=postgresql+asyncpg://coachpilot:coachpilot@localhost:5432/coachpilot
# Обязательно смените в продакшене: python -c "import secrets; print(secrets.token_urlsafe(48))"
CP_JWT_SECRET=dev-secret-change-me-dev-secret-change-me

# AI-провайдер: mock (по умолчанию, без ключей) | yandexgpt | gigachat | openai_compat
CP_AI_PROVIDER=mock
# YandexGPT: API-ключ сервисного аккаунта и id каталога Yandex Cloud
# CP_AI_PROVIDER=yandexgpt
# CP_AI_API_KEY=...
# CP_AI_FOLDER_ID=...
# GigaChat: ключ авторизации (Basic) и сертификат НУЦ Минцифры
# CP_AI_PROVIDER=gigachat
# CP_AI_API_KEY=...
# CP_AI_CA_BUNDLE=/etc/ssl/russian_trusted_root_ca.pem
CP_AI_FREE_QUOTA_MONTH=30
